# ============================================
# 环境变量模板（成员 A 维护）
# 用法：
#   1) 复制本文件为 .env      ->  copy .env.example .env
#   2) 把等号右边补上自己的真实值
#   3) .env 已在 .gitignore 中，永远不会被提交
# ============================================

# ---- 大模型（必填，DeepSeek 官方 API，成员 B 的 agent_brain.py 读这个变量）----
# 申请地址：https://platform.deepseek.com/  ->  API Keys
DEEPSEEK_API_KEY=

# ---- 以下为可选项，不填就用括号里的默认值 ----
# 模型名（默认 deepseek-flash；若接口提示模型不存在，改成 deepseek-chat 再试）
LLM_MODEL=deepseek-flash

# 接口地址（默认 https://api.deepseek.com）
LLM_BASE_URL=https://api.deepseek.com

# ============================================
# 注意：天气数据来自 wttr.in 公共接口，免费且无需 Key；
#      待办数据保存在仓库根目录的 todo.json（已在 .gitignore 中）。
# ============================================
