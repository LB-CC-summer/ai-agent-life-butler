# ============================================
# 环境变量模板（成员 A 维护）
# 用法：
#   1) 复制本文件为 .env      ->  cp .env.example .env
#   2) 把下面每一项等号右边补上自己的真实值
#   3) .env 已在 .gitignore 中，永远不会被提交
# ============================================

# ---- 大模型（兼容 OpenAI 协议的服务任选其一）----
# DeepSeek   : https://api.deepseek.com              模型 deepseek-chat
# 通义千问   : https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 智谱 GLM   : https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 天气 API（高德 / 心知 / 和风 任选其一）----
# 高德开放平台：https://lbs.amap.com/  申请「Web服务」类型的 Key
WEATHER_API_KEY=
WEATHER_API_HOST=https://restapi.amap.com

# ---- 可选：调试开关 ----
DEBUG=false
